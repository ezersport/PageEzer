---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/Header';
import { FullWidthHero } from '../components/FullWidthHero';
import { PromoBanners } from '../components/PromoBanners';
import { BigCategoryBanners } from '../components/BigCategoryBanners';
import { CatalogSection } from '../components/CatalogSection';
import { CustomOrderSection } from '../components/CustomOrderSection';
import { AboutWorkshopSection } from '../components/AboutWorkshopSection';
import { DeliveryInfoSection } from '../components/DeliveryInfoSection';
import { FAQSection, faqs } from '../components/FAQSection';
import { SizeGuideSection } from '../components/SizeGuideSection';
import { Footer } from '../components/Footer';
import { FloatingWhatsApp } from '../components/FloatingWhatsApp';
import { SizeGuideModal } from '../components/SizeGuideModal';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Ezer Sport',
  url: 'https://ezersport.com',
  inLanguage: 'es-VE',
  publisher: { '@id': 'https://ezersport.com/#negocio' },
};

// Generado desde las mismas preguntas visibles en la sección FAQ
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<Layout
  title="Ezer Sport | Pijamas para Niños, Uniformes, Ropa Deportiva y Suéteres al Mayor"
  description="Taller de confección en Los Teques. Pijamas para niños, uniformes escolares y deportivos, suéteres, monos y franelas al detal y al mayor desde 6 piezas. Entregas en Caracas y envíos a toda Venezuela."
  preloadHero
  schemas={[websiteSchema, faqSchema]}
>
  <Header client:load />
  <main id="contenido" class="flex-1">
    <!-- HTML estático: el hero no necesita JavaScript y pinta al instante (mejor LCP) -->
    <FullWidthHero />
    <BigCategoryBanners />
    <CatalogSection client:load />
    <PromoBanners />
    <CustomOrderSection client:visible />
    <AboutWorkshopSection />
    <DeliveryInfoSection client:visible />
    <FAQSection client:visible />
    <SizeGuideSection />
  </main>

  <Footer />
  <FloatingWhatsApp />
  <SizeGuideModal client:idle />
</Layout>
